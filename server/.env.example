# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback

# Create with: openssl rand -hex 32
JWT_SECRET=

# Web client url(frontend)
FRONTEND_URL=http://localhost:5173

# Public URL del servidor (usada para generar el comando de instalación del agente)
BASE_URL=http://127.0.0.1:8000

# Ruta al binario del agente que sirve GET /servers/install/bin
# (relativa a server/ si corres `cargo run` desde ahí)
AGENT_BINARY_PATH=../agent/installer/agent-v0.1.0-beta-linux-amd64
